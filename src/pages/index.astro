  .summary-item { border-top: 1px solid var(--line); padding-top: 12px; }
  .summary-item strong, .summary-item span { display: block; }
  .summary-item strong { font-size: 1rem; }
  .summary-item span { font: .65rem 'DM Mono', monospace; text-transform: uppercase; margin-top: 5px; }
  :global(.summary-items) { display: grid; gap: 12px; margin: 20px 0; }
  :global(.summary-item) { border-top: 1px solid var(--line); padding-top: 12px; }
  :global(.summary-item strong), :global(.summary-item span) { display: block; }
  :global(.summary-item strong) { font-size: 1rem; }
  :global(.summary-item span) { font: .65rem 'DM Mono', monospace; text-transform: uppercase; margin-top: 5px; }
  :global(.summary-empty) { margin: 20px 0; color: #60635c; font: .7rem 'DM Mono', monospace; line-height: 1.5; text-transform: uppercase; }
  :global(#order-button:disabled) { cursor: not-allowed; opacity: .45; transform: none; }
  :global(.choice) { background: transparent; color: var(--cream); border: 1px solid rgba(242, 232, 213, .35); padding: 11px 15px; font-size: .9rem; cursor: pointer; }
  :global(.choice:hover), :global(.choice.selected) { background: var(--acid); border-color: var(--acid); color: var(--ink); }
  :global(.topping-choice) { display: inline-flex; align-items: center; gap: 10px; position: relative; }
  :global(.topping-choice input) { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
  :global(.topping-choice span) { display: inline-block; }
  :global(.button), :global(.header-cta) { transition: background .2s, border-color .2s; }
  :global(.button:hover), :global(.header-cta:hover) { transform: none; }
  a.button, button.button, a.header-cta { transition: background .2s, border-color .2s; }
  a.button:hover, button.button:hover, a.header-cta:hover { transform: none; }
  button.add-item { display: flex; width: fit-content; margin: 18px 0 0 auto; cursor: pointer; transition: background .2s, border-color .2s; }
  .address-link { display: inline-block; border-bottom: 1px solid var(--ink); padding-bottom: 8px; line-height: 1.45; }
  .contact-map { grid-column: 1 / -1; margin-top: 54px; border: 1px solid rgba(33, 29, 26, .2); background: var(--cream); }
  .contact-map iframe { display: block; width: 100%; height: 300px; border: 0; filter: grayscale(.25) sepia(.12); }
  .map-link { display: block; padding: 13px 15px; font: .68rem 'DM Mono', monospace; text-transform: uppercase; border-top: 1px solid var(--line); }
  .catalog-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 70px; }
  .catalog-card { min-width: 0; background: var(--cream); border: 1px solid var(--line); }
  .catalog-card summary { display: block; cursor: pointer; list-style: none; }
  .catalog-card summary::-webkit-details-marker { display: none; }
  .catalog-card summary img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; filter: saturate(.9); transition: filter .2s; }
  .catalog-card-first summary img { object-position: center top; }
  .catalog-card summary:hover img, .catalog-card[open] summary img { filter: saturate(1.1); }
  .catalog-card summary span { display: block; padding: 12px 13px 13px; font: .68rem 'DM Mono', monospace; text-transform: uppercase; }

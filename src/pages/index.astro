  @media (max-width: 760px) {
    .catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 7px; margin-top: 48px; }
    .catalog-card summary span { padding: 9px 8px 10px; font-size: .58rem; }
    .catalog-card p { padding: 0 8px 11px; font-size: .72rem; }
    .contact-map { grid-column: auto; margin-top: 42px; }
    .contact-map iframe { height: 250px; }
  }
  @media (min-width: 1000px) {
    .order-summary { width: 100%; max-width: 420px; justify-self: end; }
    .summary-apple { height: clamp(220px, 20vw, 280px); }

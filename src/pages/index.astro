</style>

<script>
  import { trackAnonymousEvent } from '../lib/analytics.js';

  const flavorData = { chamoy: ['Miguelito', 'Tajin', 'Sandia', 'Mango', 'Fresa', 'Uva', 'Mora Azul', 'Pepino'], chocolate: ['Blanco', 'Obscuro'] };
  const additionalToppingData = { chamoy: ['Gomitas', 'Skwinkles'], chocolate: ['Chispas de chocolate', 'Coco'] };
  const BASE_PRICES = { chamoy: 35, chocolate: 45 };
  const state = { base: 'chamoy', flavor: 'Miguelito', toppings: [], quantity: 1, items: [] };
  const toppingWrap = document.querySelector('#toppings');
  const flavorWrap = document.querySelector('#flavors');
  const quantity = document.querySelector('#quantity');
  const customer = document.querySelector('#customer');
  const summaryItems = document.querySelector('#summary-items');
  const summaryTotal = document.querySelector('#summary-total');

  function syncBaseButtons() {
    document.querySelectorAll('[data-choice="base"]').forEach((button) => {
      button.classList.toggle('selected', button.dataset.value === state.base);
    });
  }

  function resetBuilder() {
    state.base = 'chamoy';
    state.flavor = flavorData.chamoy[0];
    state.toppings = [];
    state.quantity = 1;
    renderOptions();
    syncBaseButtons();
    updateSummary();
  }

  function getItemPrice(base, toppings) {
    const basePrice = BASE_PRICES[base] ?? 0;
    if (base === 'chamoy') {
      return basePrice + (toppings.length * 10);
    }
    return basePrice;
  }

  function getOrderTotal() {
    return state.items.reduce((total, item) => total + (getItemPrice(item.base, item.toppings) * item.quantity), 0);
  }

  function formatMoney(value) {
    return `$${value.toLocaleString('es-MX')} MXN`;
  }

  function describeItem(item) {
    const toppings = item.toppings.length ? ` + ${item.toppings.join(', ')}` : '';
    return { name: `${item.quantity} × Manzana de ${item.base}`, detail: `${item.flavor}${toppings}` };
  }

  function updateSummary() {
    const total = getOrderTotal();
    summaryItems.innerHTML = state.items.length ? state.items.map((item) => {
      const description = describeItem(item);
      const itemTotal = getItemPrice(item.base, item.toppings) * item.quantity;
      return `<div class="summary-item"><strong>${description.name}</strong><span>${description.detail}</span><span>${formatMoney(itemTotal)}</span></div>`;
    }).join('') : '<p class="summary-empty">Tu carrito está vacío.<br />Agrega una combinación para continuar.</p>';
    summaryTotal.textContent = state.items.length ? formatMoney(total) : 'Por confirmar';
    document.querySelector('#order-button').disabled = state.items.length === 0;
    quantity.textContent = state.quantity;
  }

  function renderOptions() {
    const base = state.base;
    const flavorButtons = flavorData[base].map((item, index) => `<button class="choice flavor-choice ${index === 0 && state.flavor === item ? 'selected' : ''}" data-choice="flavor" data-value="${item}">${item}</button>`).join('');
    const toppingButtons = additionalToppingData[base].map((item) => {
      const checked = state.toppings.includes(item);
      return `<label class="choice topping-choice ${checked ? 'selected' : ''}"><input type="checkbox" data-choice="additionalTopping" value="${item}" ${checked ? 'checked' : ''} /> <span>${item}</span></label>`;
    }).join('');
    flavorWrap.innerHTML = flavorButtons;
    toppingWrap.innerHTML = toppingButtons;
    state.flavor = state.flavor && flavorData[base].includes(state.flavor) ? state.flavor : flavorData[base][0];
    state.toppings = base === 'chocolate' ? state.toppings.filter((item) => additionalToppingData.chocolate.includes(item)).slice(0, 1) : state.toppings.filter((item) => additionalToppingData[base].includes(item));
    syncBaseButtons();
  }

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-choice]');
    if (!button) return;

    const choice = button.dataset.choice;

    if (choice === 'base') {
      state.base = button.dataset.value;
      trackAnonymousEvent('base_selected', { base: state.base });
      state.flavor = flavorData[state.base][0];
      state.toppings = [];
      renderOptions();
      syncBaseButtons();
      updateSummary();
      return;
    }

    if (choice === 'flavor') {
      state.flavor = button.dataset.value;
      button.parentElement.querySelectorAll('[data-choice]').forEach((item) => item.classList.remove('selected'));
      button.classList.add('selected');
      updateSummary();
      return;
    }
  });

  document.addEventListener('change', (event) => {
    const input = event.target.closest('input[data-choice="additionalTopping"]');
    if (!input) return;

    const value = input.value;
    if (state.base === 'chocolate') {
      const allInputs = toppingWrap.querySelectorAll('input[data-choice="additionalTopping"]');
      allInputs.forEach((checkbox) => {
        const isSelected = checkbox === input && input.checked;
        checkbox.checked = isSelected;
        const label = checkbox.closest('.topping-choice');
        label.classList.toggle('selected', isSelected);
      });
      state.toppings = input.checked ? [value] : [];
    } else {
      state.toppings = input.checked
        ? [...new Set([...state.toppings, value])]
        : state.toppings.filter((item) => item !== value);

      const allInputs = toppingWrap.querySelectorAll('input[data-choice="additionalTopping"]');
      allInputs.forEach((checkbox) => {
        const label = checkbox.closest('.topping-choice');
        label.classList.toggle('selected', checkbox.checked);
      });
    }
    updateSummary();
  });

  document.querySelector('#plus').addEventListener('click', () => { state.quantity += 1; updateSummary(); });
  document.querySelector('#minus').addEventListener('click', () => { state.quantity = Math.max(1, state.quantity - 1); updateSummary(); });
  document.querySelector('#add-item').addEventListener('click', () => {
    state.items.push({
      base: state.base,
      flavor: state.flavor,
      toppings: [...state.toppings],
      quantity: state.quantity,
    });
    trackAnonymousEvent('add_to_cart', { base: state.base, quantity: state.quantity });
    resetBuilder();
  });
  document.querySelector('#order-button').addEventListener('click', () => {
    const name = customer.value.trim();
    const total = getOrderTotal();
    const itemCount = state.items.reduce((count, item) => count + item.quantity, 0);
    trackAnonymousEvent('whatsapp_order_click', { item_count: itemCount, total_amount: total });
    const orderLines = state.items.map((item) => {
      const toppings = item.toppings.length ? `, toppings: ${item.toppings.join(', ')}` : '';
      const itemTotal = getItemPrice(item.base, item.toppings) * item.quantity;
      return `${item.quantity} x ${item.base}, sabor: ${item.flavor}${toppings} (${formatMoney(itemTotal).replace(' MXN', '')})`;
    }).join('%0A');
    const nameLine = name ? `%0ANombre: ${name}` : '';
    const message = `Hola Mora Mora!%0A%0AQuiero pedir:%0A${orderLines}%0A%0ATotal estimado: ${formatMoney(total).replace(' MXN', '')}${nameLine}`;
    const whatsappNumber = document.querySelector('main').dataset.whatsapp;
    if (whatsappNumber) window.open(`https://wa.me/${whatsappNumber}?text=${message}`, '_blank', 'noopener');
    else alert('WhatsApp esta listo para conectarse. Agrega el numero en src/data/business.ts.');
  });
  document.querySelector('#wholesale-button').addEventListener('click', (event) => { event.preventDefault(); trackAnonymousEvent('wholesale_quote_click'); const whatsappNumber = document.querySelector('main').dataset.whatsapp; window.open(`https://wa.me/${whatsappNumber}?text=Hola%20Mora%20Mora,%20quiero%20cotizar%20un%20pedido%20de%20mayoreo.`, '_blank', 'noopener'); });
  document.querySelector('.social-link').addEventListener('click', () => trackAnonymousEvent('instagram_profile_click'));
  document.querySelector('.contact-info .button-red').addEventListener('click', () => trackAnonymousEvent('whatsapp_contact_click'));
  document.querySelector('.menu-button').addEventListener('click', (event) => { const button = event.currentTarget; const open = button.getAttribute('aria-expanded') === 'true'; const nextOpen = !open; button.setAttribute('aria-expanded', String(nextOpen)); button.setAttribute('aria-label', nextOpen ? 'Cerrar menu' : 'Abrir menu'); document.querySelector('.site-header nav').classList.toggle('mobile-open', nextOpen); });
  renderOptions();
  syncBaseButtons();
  updateSummary();
</script>